rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────
    // 헬퍼 함수
    // ──────────────────────────────────────────────

    /** 현재 요청자가 로그인되어 있는지 확인 */
    function isSignedIn() {
      return request.auth != null;
    }

    /** 현재 요청자가 해당 userId 본인인지 확인 */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** 쓰기 시 uid 필드가 본인 UID와 일치하는지 검증 (uid 위조 방지) */
    function hasValidUid(userId) {
      return !('uid' in request.resource.data)
          || request.resource.data.uid == userId;
    }

    /** 링크 문서 필드 유효성 검사 */
    function isValidLinkData() {
      let data = request.resource.data;
      return data.keys().hasAll(['title', 'url'])
          && data.title is string && data.title.size() > 0 && data.title.size() <= 200
          && data.url   is string && data.url.size()   > 0 && data.url.size()   <= 2048
          && (!('subtitle' in data) || data.subtitle is string)
          && (!('icon'     in data) || data.icon     is string)
          && (!('badge'    in data) || data.badge    == null || data.badge is string)
          && (!('isActive' in data) || data.isActive is bool);
    }

    /** 프로필 문서 필드 유효성 검사 */
    function isValidProfileData() {
      let data = request.resource.data;
      return (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 50))
          && (!('username'    in data) || (data.username    is string && data.username.size()    <= 30))
          && (!('bio'         in data) || (data.bio         is string && data.bio.size()         <= 300))
          && (!('role'        in data) || (data.role        is string && data.role.size()        <= 50))
          && (!('photoURL'    in data) || data.photoURL == null || data.photoURL is string)
          && (!('email'       in data) || data.email is string);
    }

    // ──────────────────────────────────────────────
    // users/{userId}  —  메인 사용자 문서
    // ──────────────────────────────────────────────
    match /users/{userId} {

      // 읽기: 누구나 허용
      allow read: if true;

      // 생성: 본인만 가능 + uid 위조 방지 + 프로필 필드 검증
      allow create: if isOwner(userId)
                    && hasValidUid(userId)
                    && isValidProfileData();

      // 수정: 본인만 가능 + uid 변경 금지 + 필드 검증
      allow update: if isOwner(userId)
                    && hasValidUid(userId)
                    && isValidProfileData();

      // 삭제: 본인만 가능
      allow delete: if isOwner(userId);

      // ────────────────────────────────────────────
      // users/{userId}/links/{linkId}  —  링크 목록
      // ────────────────────────────────────────────
      match /links/{linkId} {

        // 읽기: 누구나 허용
        allow read: if true;

        // 생성: 본인만 가능 + 필수 필드 검증
        allow create: if isOwner(userId)
                      && isValidLinkData();

        // 수정: 본인만 가능 + 필드 검증
        allow update: if isOwner(userId)
                      && isValidLinkData();

        // 삭제: 본인만 가능
        allow delete: if isOwner(userId);
      }

      // ────────────────────────────────────────────
      // users/{userId}/profile/{docId}  —  프로필 서브컬렉션
      //   · profile/profile  (기본 프로필 문서)
      //   · profile/info     (호환용 문서)
      // ────────────────────────────────────────────
      match /profile/{docId} {

        // 읽기: 누구나 허용
        allow read: if true;

        // 생성: 본인만 가능 + uid 위조 방지 + 필드 검증
        allow create: if isOwner(userId)
                      && hasValidUid(userId)
                      && isValidProfileData();

        // 수정: 본인만 가능 + uid 변경 금지 + 필드 검증
        allow update: if isOwner(userId)
                      && hasValidUid(userId)
                      && isValidProfileData();

        // 삭제: 본인만 가능
        allow delete: if isOwner(userId);
      }
    }

    // ──────────────────────────────────────────────
    // usernames/{username}  —  username 중복 방지용 선점 컬렉션
    // ──────────────────────────────────────────────
    match /usernames/{username} {

      // 읽기: 누구나 허용 (중복 확인 용도)
      allow read: if true;

      // 생성: 로그인한 사용자만 가능 + uid 본인 소유로만 등록
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;

      // 수정: 해당 username 소유자(uid 일치)만 가능
      allow update: if isSignedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;

      // 삭제: 해당 username 소유자만 가능
      allow delete: if isSignedIn()
                    && resource.data.uid == request.auth.uid;
    }

    // ──────────────────────────────────────────────
    // 그 외 모든 경로: 차단
    // ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
